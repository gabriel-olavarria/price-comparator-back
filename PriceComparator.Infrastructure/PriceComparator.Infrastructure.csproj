<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\PriceComparator.Application\PriceComparator.Application.csproj" />
      <ProjectReference Include="..\PriceComparator.Domain\PriceComparator.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AngleSharp" Version="1.7.0-beta.583" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.6.26359.118" />
      <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    </ItemGroup>
    
    <ItemGroup>
        <Content Include="Snapshots/Data/**/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Snapshots\Data\Jumbo\" />
      <Folder Include="Snapshots\Data\Lider\" />
      <Folder Include="Snapshots\Data\Unimarc\" />
    </ItemGroup>

</Project>
